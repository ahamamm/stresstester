
# A. to run mq container 
# 1.  unzip mqm.zip to /opt/mqm
# 2. add follwoing to ~/.bashrc
    export MQLICENSE=accept
    export MQ_INSTALLATION_PATH=/opt/mqm
    export LD_LIBRARY_PATH=$MQ_INSTALLATION_PATH/lib64:$LD_LIBRARY_PATH
    export LD_LIBRARY_PATH=$MQ_INSTALLATION_PATH/bin:$LD_LIBRARY_PATH
    export PATH=$PATH:$MQ_INSTALLATION_PATH/bin
    export CGO_LDFLAGS="-L/opt/mqm/lib64 -lmqm_r"
    export CGO_CFLAGS="-I/opt/mqm/inc"


# B.Podman commands
# 1. Remove the old container
podman rm -f my-ibm-mq

# 2. Spin up a new one with explicit credentials
docker run 
  --platform linux/amd64 \
  --env LICENSE=accept \
  --env MQ_QMGR_NAME=QM1 \
  --env MQ_ADMIN_PASSWORD=passw0rd \
  --env MQ_APP_PASSWORD=passw0rd \
  --publish 1414:1414 \
  --publish 9443:9443 \
  --detach \
  --name my-ibm-mq \
  icr.io/ibm-messaging/mq:latest



# 3 console URL
  https://localhost:9443/ibmmq/console/#/manage/qmgr/QM1/queues



podman run --platform linux/amd64 --env LICENSE=accept --env MQ_QMGR_NAME=QM1 --env MQ_ADMIN_PASSWORD=passw0rd --env MQ_APP_PASSWORD=passw0rd  -v ~/mq_storage/:/mnt/mqm:Z --net mq-bridge --publish 1414:1414 --publish 9443:9443 --detach --name my-ibm-mq --replace icr.io/ibm-messaging/mq:latest && podman logs -f my-ibm-mq



