to seolve security issue
alter securty by

# 1. Open the MQ interactive console inside your running container:
podman exec -it my-ibm-mq runmqsc QM1

then past these commands
# 2. Allow the default channel to accept connections without strict user matching
ALTER CHL(DEV.APP.SVRCONN) CHLTYPE(SVRCONN) MCAUSER('mqm')

# 3. Refresh the security cache
REFRESH SECURITY TYPE(CONNAUTH)

# 4. Exit the console
END

another solution

do step 1 then

# Alternative A: Allow a specific application user ID (e.g., 'app')
SET CHLAUTH('DEV.APP.SVRCONN') TYPE(USERMAP) CLNTUSER('app') USERSRC(MAP) MCAUSER('app') ACTION(REPLACE)

# Alternative B: Just clear the block rule completely on the dev channel(recommended)
SET CHLAUTH('DEV.APP.SVRCONN') TYPE(ADDRESSMAP) ADDRESS('*') USERSRC(CHANNEL) ACTION(REPLACE)

# Always refresh security after changes
# REFRESH SECURITY TYPE(CONNAUTH)



